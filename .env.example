# Public values can be exposed to the browser; never place private keys here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only — do not prefix with NEXT_PUBLIC_
OPENAI_API_KEY=
# No paid AI requests until the administrator explicitly enables them.
AI_EXECUTION_ENABLED=false
AI_PILOT_ENABLED=false
# Advanced chat and private-document tools; no silent cheaper fallback.
LEGAL_AI_MODEL=gpt-6-astra
OPENAI_MODEL=gpt-5-mini
# Optional: model with Responses web_search support. Empty uses OPENAI_MODEL.
OPENAI_RESEARCH_MODEL=
# Server-side only: saves verified analysis results; NEVER use NEXT_PUBLIC_ for this key.
SUPABASE_SERVICE_ROLE_KEY=
# Test checkout only. Live keys are rejected, no AI entitlement is granted.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Email of the authenticated Supabase user permitted to run checkout tests.
BILLING_TEST_EMAIL=
# Signing secret of the Stripe sandbox webhook (never share this value).
STRIPE_WEBHOOK_SECRET=
# Commercial research and live funding: OFF until release checklist is satisfied.
AI_COMMERCIAL_ENABLED=false
AI_COMMERCIAL_TARIFFS_JSON=
LIC_LIVE_CHECKOUT_ENABLED=false
LIC_LIVE_TAX_READY=false
LIC_LIVE_TERMS_VERSION=
LIC_LIVE_TERMS_URL=
STRIPE_LIVE_INDIVIDUAL_PRICE_ID=
STRIPE_LIVE_BUSINESS_PRICE_ID=
STRIPE_LIVE_CREDITS_TAX_CODE=
STRIPE_LIVE_CREDITS_WEBHOOK_SECRET=
